{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-pc-release",
      "displayName": "KIMIA Windows PC Release",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-pc-release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "KIMIA_RENDER_BACKEND": "D3D11",
        "KIMIA_BUILD_PC": "ON",
        "KIMIA_BUILD_TESTS": "OFF",
        "KIMIA_BUILD_TOOLS": "ON",
        "KIMIA_ENABLE_D3D11": "ON",
        "KIMIA_WERROR": "ON"
      }
    },
    {
      "name": "windows-pc-debug",
      "displayName": "KIMIA Windows PC Debug",
      "inherits": "windows-pc-release",
      "binaryDir": "${sourceDir}/out/build/windows-pc-debug",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug"
      }
    },
    {
      "name": "webgl-release",
      "displayName": "KIMIA WebGL/WASM Release (Emscripten)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/webgl-release",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "KIMIA_RENDER_BACKEND": "OPENGL",
        "KIMIA_ENABLE_SDL2": "OFF",
        "KIMIA_BUILD_PC": "OFF",
        "KIMIA_ENABLE_D3D11": "OFF",
        "KIMIA_BUILD_TESTS": "OFF",
        "KIMIA_BUILD_TOOLS": "OFF",
        "KIMIA_WERROR": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-pc-release",
      "configurePreset": "windows-pc-release",
      "configuration": "Release"
    },
    {
      "name": "windows-pc-debug",
      "configurePreset": "windows-pc-debug",
      "configuration": "Debug"
    },
    {
      "name": "webgl-release",
      "configurePreset": "webgl-release",
      "configuration": "Release"
    }
  ]
}
